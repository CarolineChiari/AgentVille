{
  "name": "agentville",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "description": "Every coding-agent session on your machine (Claude Code, GitHub Copilot, Cursor, Antigravity), as a villager in a pixel-art village.",
  "author": "Caroline Chiari",
  "main": "electron/main.mjs",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && node server/serve.mjs",
    "serve": "node server/serve.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder --publish never",
    "sheet": "node tools/sheet.mjs",
    "shots": "node tools/shots.mjs"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "dev.agentville.app",
    "productName": "AgentVille",
    "copyright": "Copyright © 2026 Caroline Chiari",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "electron/**",
      "server/**",
      "dist/**",
      "src/render/sprites/palette.js",
      "src/game/tasks.js"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
